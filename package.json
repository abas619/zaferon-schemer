{
  "name": "zaferon-schemer",
  "productName": "Zaferon Schemer",
  "version": "1.0.0",
  "description": "Zaferon Schemer — a desktop color studio: matching colors, live schemes, mixer, variations, photo color extraction and a full-screen eyedropper.",
  "main": "main.js",
  "author": "Abbas (abas619)",
  "license": "MIT",
  "homepage": "https://github.com/abas619/zaferon-schemer",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "assets": "node build/make-assets.js",
    "icons": "node build/make-icons.js",
    "shots": "electron build/shots.js",
    "smoke": "electron build/smoke.js",
    "verify": "electron build/verify.js",
    "firstrun": "electron build/firstrun.js",
    "store-test": "node build/store-test.js",
    "css-check": "node build/css-coverage.js",
    "preview": "node build/preview.js",
    "preview-metrics": "node build/preview-metrics.js",
    "panel-probe": "node build/panel-probe.js",
    "picker-test": "electron build/picker-test.js",
    "menu-audit": "electron build/menu-audit.js",
    "menu-shots": "electron build/menu-audit.js --shots",
    "support-check": "electron build/support-check.js",
    "donate-check": "node build/donate-check.js",
    "update-check": "node build/update-check.js",
    "update-shots": "electron build/update-shots.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:publish": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.zaferon.schemer",
    "productName": "Zaferon Schemer",
    "copyright": "Copyright © 2026 Abbas (abas619)",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "picker-overlay.js",
      "updater.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] }
      ],
      "icon": "src/assets/icon@2x.png",
      "category": "Graphics",
      "synopsis": "Desktop colour studio: harmonies, mixer, eyedropper",
      "maintainer": "Abbas <abas619@users.noreply.github.com>",
      "desktop": {
        "Name": "Zaferon Schemer",
        "Comment": "Desktop colour studio",
        "Keywords": "color;colour;palette;scheme;eyedropper;design;"
      }
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "src/assets/icon@2x.png",
      "category": "public.app-category.design",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    },
    "publish": {
      "provider": "github",
      "owner": "abas619",
      "repo": "zaferon-schemer"
    }
  },
  "keywords": [
    "color",
    "palette",
    "scheme",
    "electron",
    "eyedropper",
    "color-picker"
  ],
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^24.0.0",
    "lucide-static": "^1.46.0",
    "qrcode-generator": "^2.0.4"
  },
  "dependencies": {
    "electron-updater": "^6.0.0"
  }
}
