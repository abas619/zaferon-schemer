{
  "name": "zaferon-schemer",
  "productName": "Zaferon Schemer",
  "version": "1.0.1",
  "description": "Zaferon Schemer — a desktop color studio: matching colors, live schemes, mixer, variations, photo color extraction and a full-screen eyedropper.",
  "main": "main.js",
  "author": "Abbas (abas619)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "assets": "node build/make-assets.js",
    "icons": "node build/make-icons.js",
    "shots": "electron build/shots.js",
    "smoke": "electron build/smoke.js",
    "verify": "electron build/verify.js",
    "firstrun": "electron build/firstrun.js",
    "store-test": "node build/store-test.js",
    "css-check": "node build/css-coverage.js",
    "preview": "node build/preview.js",
    "preview-metrics": "node build/preview-metrics.js",
    "panel-probe": "node build/panel-probe.js",
    "picker-test": "electron build/picker-test.js",
    "menu-audit": "electron build/menu-audit.js",
    "menu-shots": "electron build/menu-audit.js --shots",
    "support-check": "electron build/support-check.js",
    "donate-check": "node build/donate-check.js",
    "update-check": "node build/update-check.js",
    "update-shots": "electron build/update-shots.js",
    "dist": "electron-builder --win --publish never",
    "dist:publish": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.zaferon.schemer",
    "productName": "Zaferon Schemer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "picker-overlay.js",
      "updater.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "abas619",
      "repo": "zaferon-schemer"
    }
  },
  "keywords": [
    "color",
    "palette",
    "scheme",
    "electron",
    "eyedropper",
    "color-picker"
  ],
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^24.0.0",
    "lucide-static": "^1.46.0",
    "qrcode-generator": "^2.0.4"
  },
  "dependencies": {
    "electron-updater": "^6.0.0"
  }
}
